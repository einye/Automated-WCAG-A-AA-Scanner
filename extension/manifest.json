{
  "manifest_version": 3,
  "name": "Accessibility Checker extension",
  "version": "1.0",
  "description": "Scan authenticated pages for accessibility issues.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Page"
  },
  "options_page": "options.html"
}
