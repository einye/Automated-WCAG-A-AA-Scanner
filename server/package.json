{
  "name": "accessibility-checker-rcc",
  "version": "1.0.0",
  "description": "Accessibility Scanner App Monorepo",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node app.js",
    "client": "npm run dev --prefix ../client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.1.2",
    "axe-core": "^4.10.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.12.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
