        // Render the results from the JSON object
        renderResults(responseData);

        function renderResults(data) {
            // Display summary info
            const scannedDate = new Date(data.scannedAt).toLocaleString();
            summaryInfo.innerHTML = `
                <p><strong>URL:</strong> ${data.url}</p>
                <p><strong>Scanned At:</strong> ${scannedDate}</p>
            `;

            const results = data.results;

            const renderCategory = (categoryName, items) => {
                if (!items || items.length === 0) {
                    return; // Don't render empty categories
                }

                const categoryDiv = document.createElement('div');
                categoryDiv.className = `category-group ${categoryName.toLowerCase()}`;
                categoryDiv.innerHTML = `<h2>${categoryName.charAt(0).toUpperCase() + categoryName.slice(1)}</h2>`;

                items.forEach(item => {
                    const ruleDiv = document.createElement('div');
                    ruleDiv.className = `rule-item ${categoryName.toLowerCase()}`;
                    
                    const tags = item.tags.filter(tag => tag.startsWith('cat.')).map(tag => {
                        return tag.replace('cat.', '');
                    }).join(', ');

                    ruleDiv.innerHTML = `
                        <div class="rule-id">${item.id}</div>
                        ${tags ? `<div class="rule-tags">Tags: ${tags}</div>` : ''}
                        <div class="description">${item.description}</div>
                        <div class="help-url">Help: <a href="${item.helpUrl}" target="_blank">${item.help}</a></div>
                    `;

                    // Only show affected nodes if the array is not empty
                    if (item.nodes && item.nodes.length > 0) {
                        const nodesDiv = document.createElement('div');
                        nodesDiv.className = 'affected-nodes';
                        nodesDiv.innerHTML = `<h4>Affected Elements:</h4>`;

                        item.nodes.forEach(node => {
                            if (node.html) {
                                const htmlSnippet = document.createElement('pre');
                                htmlSnippet.className = 'html-snippet';
                                htmlSnippet.textContent = node.html;
                                nodesDiv.appendChild(htmlSnippet);
                            }
                        });
                        ruleDiv.appendChild(nodesDiv);
                    }
                    
                    categoryDiv.appendChild(ruleDiv);
                });
                resultsContainer.appendChild(categoryDiv);
            };

            // Order of rendering categories
            renderCategory('Violations', results.violations);
            renderCategory('Fails', results.fails);
            renderCategory('Incomplete', results.incomplete);
            renderCategory('Passes', results.passes);
            renderCategory('Inapplicable', results.inapplicable);
        }
    </script>
